# Externe poort op de host (browser: http://<host>:APP_PORT)
APP_PORT=8888

# URL waar de browser go2rtc bereikt (zelfde host-IP, standaard poort 1984)
GO2RTC_PUBLIC_URL=http://10.5.0.103:1984

# Niet PORT=8888 zetten in Docker — dat breekt de poort-mapping (8888:8080).
# Alleen APP_PORT gebruiken voor een andere externe poort.
